{
  "name": "pos-inventory-erp",
  "version": "1.0.0",
  "description": "Offline-first POS and Inventory ERP desktop application for retail stores in Pakistan.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite --port 5173 --strictPort false",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:electron": "npm run prepare:electron-runtime && npm run build:main && electron .",
    "dev": "node scripts/dev-launch.cjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run prepare:electron-runtime && npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "package": "npm run build && electron-builder",
    "rebuild:electron-sqlite": "npx electron-builder install-app-deps && node scripts/sqlite-runtime.cjs cache-electron",
    "rebuild:node-sqlite": "npm rebuild better-sqlite3 && node scripts/sqlite-runtime.cjs cache-node",
    "prepare:electron-runtime": "node scripts/sqlite-runtime.cjs prepare-electron",
    "prepare:test-runtime": "node scripts/sqlite-runtime.cjs prepare-node",
    "clean": "rm -rf dist dist-releases",
    "test": "npm run prepare:test-runtime && vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "pos",
    "inventory",
    "erp",
    "electron",
    "react",
    "typescript",
    "sqlite"
  ],
  "author": "Antigravity Pair Program",
  "license": "MIT",
  "build": {
    "appId": "com.erppakistan.pos",
    "productName": "Enterprise ERP",
    "copyright": "Copyright © 2025 Enterprise ERP Ltd.",
    "directories": {
      "output": "dist-releases"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/build/Release/better_sqlite3.node",
      "database/bin/**"
    ],
    "extraResources": [
      {
        "from": "database/bin/better_sqlite3_electron.node",
        "to": "better_sqlite3_electron.node"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "publisherName": "Enterprise ERP Ltd.",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Enterprise ERP",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Enterprise ERP ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^8.15.0",
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.2",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.2",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  }
}
